.define ITEM_UNKNOWN_ATTACK             BG3B, {29, 23}, {$bf,$bf,$bf,$00}  ; ???
.define ITEM_STRENGTH                   BG3B, {19, 15}, {$95,$a2,$a0,$a8,$ab,$00}  ; Vigor
.define ITEM_STAMINA                    BG3B, {19, 19}, {$92,$ad,$9a,$a6,$a2,$a7,$9a,$00}  ; Stamina
.define ITEM_MAG_PWR                    BG3B, {19, 21}, {$8c,$9a,$a0,$c5,$8f,$b0,$ab,$00}  ; Mag.Pwr
.define ITEM_EVADE                      BG3B, {19, 27}, {$84,$af,$9a,$9d,$9e,$ff,$cd,$00}  ; Evade %
